{
  "name": "@thememorypalace/photo-date",
  "version": "0.1.0",
  "description": "Read when a photo was taken: EXIF and XMP dates from JPEG, HEIC, PNG, WebP and TIFF, with fallbacks for WhatsApp, screenshot and camera file names, and a confidence level for each answer. Zero dependencies, runs in Node and the browser.",
  "keywords": [
    "exif",
    "photo",
    "date",
    "datetimeoriginal",
    "heic",
    "metadata",
    "xmp",
    "whatsapp",
    "screenshot",
    "genealogy"
  ],
  "homepage": "https://www.thememorypalace.ai/photo-date",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thememorypalace/photo-date.git"
  },
  "bugs": {
    "url": "https://github.com/thememorypalace/photo-date/issues"
  },
  "license": "MIT",
  "author": "The Memory Palace (https://www.thememorypalace.ai)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
